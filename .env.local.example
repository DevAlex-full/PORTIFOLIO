# 📁 CAMINHO: .env.local.example
# Copie para .env.local e preencha os valores

# URL da API backend (portfolio-backend)
# Desenvolvimento: http://localhost:3001
# Produção: https://portfolio-backend.onrender.com (ou seu domínio)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Número de WhatsApp fallback (caso a API esteja offline)
# Formato: código_país + DDD + número (sem espaços ou traços)
NEXT_PUBLIC_WHATSAPP=5511983943905